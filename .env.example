# VoxPassport deployment mode
# true = single-user/local deployment: no login/signup/account service and no multi-user abuse controls.
VOXPASSPORT_LOCAL_ONLY=false

# These can be controlled independently when local-only is false.
VOXPASSPORT_AUTH_ENABLED=true
VOXPASSPORT_ABUSE_CONTROLS_ENABLED=true
VOXPASSPORT_ACCOUNT_API_URL=http://127.0.0.1:8780

# Optional JSON deployment config. Environment/.env values override matching JSON values.
# VOXPASSPORT_DEPLOYMENT_CONFIG=configs/deployment.json

# BYO direct speech provider credentials for local/private deployments.
# GEMINI_API_KEY=

# Native audio helper override, normally discovered from target/{debug,release}.
# VOXPASSPORT_AUDIO_HELPER=C:\path\to\voxpassport-audio-helper.exe
