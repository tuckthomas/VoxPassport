{
  "expo": {
    "name": "VoxPassport",
    "slug": "voxpassport",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "voxpassport",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.voxpassport.app"
    },
    "android": {
      "package": "com.voxpassport.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow VoxPassport to access your microphone for live translation and voice enrollment.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
