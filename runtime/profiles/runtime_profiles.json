{
  "schema_version": 1,
  "profiles": {
    "core": {
      "interpreter": ".venv/Scripts/python.exe",
      "interpreter_env": "VOXPASSPORT_CORE_TTS_PYTHON",
      "startup_timeout_seconds": 30,
      "idle_timeout_seconds": 60,
      "environment": {},
      "provisioning": {
        "strategy": "shared-primary-environment",
        "installer": "install.bat",
        "notes": "The core TTS runtime is dependency-compatible with the primary VoxPassport Python environment."
      }
    },
    "coqui-xtts": {
      "interpreter": ".venv-xtts/Scripts/python.exe",
      "interpreter_env": "VOXPASSPORT_XTTS_PYTHON",
      "startup_timeout_seconds": 45,
      "idle_timeout_seconds": 30,
      "environment": {},
      "provisioning": {
        "strategy": "isolated-environment",
        "venv_dir": ".venv-xtts",
        "python_version": "3.12",
        "prefer_uv": true,
        "steps": [
          {
            "packages": [
              "torch==2.13.0",
              "torchaudio==2.11.0",
              "torchcodec==0.13.0"
            ],
            "index_url": "https://download.pytorch.org/whl/cu130"
          },
          {
            "requirements": "runtime/workers/tts_host/requirements-xtts.txt"
          }
        ],
        "notes": "Coqui/XTTS remains isolated because its dependency constraints must not constrain the main Transformers/Parakeet environment."
      }
    }
  }
}
