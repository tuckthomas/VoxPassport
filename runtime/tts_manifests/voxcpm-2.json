{
  "schema_version": 2,
  "model_id": "voxcpm-2",
  "display_name": "VoxCPM 2",
  "aliases": [
    "voxcpm",
    "openbmb-voxcpm2",
    "openbmb/VoxCPM2"
  ],
  "runtime_profile": "core",
  "driver": {
    "entrypoint": "runtime.workers.tts_host.drivers.openai_proxy:OpenAiSpeechProxyDriver",
    "options": {
      "backend_url": "http://127.0.0.1:8097",
      "backend_url_env": "VOXPASSPORT_VOXCPM_TTS_URL",
      "health_path": "/v1/models",
      "speech_path": "/v1/audio/speech",
      "static_payload": {
        "model": "openbmb/VoxCPM2",
        "voice": "default",
        "stream_format": "audio"
      },
      "text_field": "input",
      "response_format_field": "response_format",
      "stream_field": "stream",
      "language_field": null,
      "language_format": "omit",
      "reference_audio_field": "ref_audio",
      "reference_audio_encoding": "data_uri",
      "reference_text_field": "ref_text",
      "timeout_seconds": 300
    }
  },
  "capabilities": {
    "languages": [
      "ar", "da", "nl", "en", "fi", "fr", "de", "el", "he", "hi",
      "id", "it", "ja", "ko", "ms", "no", "pl", "pt", "ru", "es",
      "sv", "tl", "th", "tr", "vi", "zh"
    ],
    "streaming": true,
    "voice_cloning": true,
    "cross_lingual_voice_cloning": true
  },
  "voice_cloning": {
    "reference_transcript_required": true
  },
  "audio": {
    "sample_rate_hz": 48000,
    "sample_format": "pcm_s16le"
  },
  "registry": {
    "family": "voxcpm",
    "provider": "OpenBMB",
    "upstream_id": "openbmb/VoxCPM2",
    "revision": "main",
    "download_gb": 4.8,
    "vram": {
      "default": "benchmark locally"
    },
    "ram_gb": 8.0,
    "license": "verify upstream model terms",
    "commercial_use": "verify",
    "redistribution": "verify",
    "trust_level": "OFFICIAL_VERIFIED",
    "recommendation": "CANDIDATE"
  }
}
